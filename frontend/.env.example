# Local development on the same laptop
VITE_API_BASE_URL=http://localhost:8080/api/v1

# LAN phone testing example
# Replace the IP address with your laptop IPv4 address.
# VITE_API_BASE_URL=http://192.168.0.41:8080/api/v1

# Production example
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1

# Optional web push public key
# VITE_VAPID_PUBLIC_KEY=
